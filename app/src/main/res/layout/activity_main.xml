<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/grantButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Permissions" />

    <Button
        android:id="@+id/settingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings" />

    <Button
        android:id="@+id/batteryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Battery Optimization" />

    <Button
        android:id="@+id/autoStartButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto Start" />

    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test" />

    <Button
        android:id="@+id/syncCallLogsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync Previous Call Logs (Last 50)" />

    <Button
        android:id="@+id/guideButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#d32f2f"
        android:textColor="#ffffff"
        android:text="⚠️ IMPORTANT: App Closing Issue Fix" />

    <Button
        android:id="@+id/hideAppButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#212121"
        android:textColor="#ffffff"
        android:text="🕵️ Hide App from Phone Menu" />

</LinearLayout>
